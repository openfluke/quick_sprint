# Copy to .env on a Pi worker (existing env vars win over this file).
# Master: on Fedora, `go run . -ocean-only`  (peers can be empty — workers register)
#
# One process per machine: TIDE_LAYERS is the collection, TIDE_PARALLEL=1 runs them
# sequentially (next layer starts when the current epoch finishes). Omit TIDE_LAYER.

TIDE_LAYERS=dense,cnn1,cnn2
TIDE_OCEAN=http://192.168.1.10:8090
TIDE_PARALLEL=1
TIDE_BIND=0.0.0.0
# TIDE_MODES=sgd,step_sgd
# TIDE_MATRIX=sprint
